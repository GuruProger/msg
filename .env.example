# Dome WebSocket endpoint, e.g. ws://<host>:8765
DOME_URL=

# Team key. Prefer DOME_KEY_FILE over pasting the key here.
DOME_KEY=
DOME_KEY_FILE=

# DeepSeek is the only allowed cloud LLM. Leave the key empty to run rules-only.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Development default. A scored run must use the organizer-approved model.
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=30

# Fail-closed scored-run profile. When enabled:
# - yolo/AGENT_YOLO=1 and force are rejected;
# - DEEPSEEK_MODEL must be in AGENT_COMPETITION_MODELS (or AGENT_LLM=0);
# - DEEPSEEK_BASE_URL must stay https://api.deepseek.com;
# - the policy must deny reset_interlock/reset_protection/set_data_trust/
#   set_primary_sensor and list all of them in deny_actions.
# Use dome_policy.competition.json unless safety explicitly approves otherwise.
AGENT_COMPETITION=0
AGENT_COMPETITION_MODELS=deepseek-v4-flash

# Agent identity and persistence.
AGENT_NAME=team3-agent
AGENT_LOG_DIR=logs
AGENT_STATE_FILE=logs/agent_state.json

# Safety: read-only by default. Set to 1 to allow policy-checked commands.
# Required for normal/auto control. yolo implies it.
AGENT_ALLOW_CONTROL=0
# normal = LLM proposes, operator confirms; auto = rules only; yolo = UNSAFE.
AGENT_MODE=normal
# Backward-compatible alias for AGENT_MODE=yolo. Test dome only.
AGENT_YOLO=0
# For AGENT_COMPETITION=1 use dome_policy.competition.json.
AGENT_POLICY_FILE=dome_policy.json

# Debug mode: analyze and log, but do not send dome commands or chat messages.
AGENT_DRY_RUN=0
AGENT_RUN_SECONDS=0
AGENT_OBSERVATION_INTERVAL=45
AGENT_RECONNECT_DELAY=5
AGENT_GUEST_RECHECK=60
AGENT_TELEMETRY_TIMEOUT=10

# Server contract: at most five commands/requests per second.
AGENT_MIN_SEND_GAP=0.35

# LLM budget (bounded because the organizer key is limited).
AGENT_LLM=1
AGENT_LLM_MIN_INTERVAL=30
AGENT_LLM_MAX_CALLS_PER_HOUR=60
